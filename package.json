{
  "name": "dashboard-performance-rewrite",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "A standalone demo of per-panel data fetching against a shared query layer, with simulated endpoints and latency and an on-screen request counter.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.59.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.2",
    "jsdom": "25.0.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.9",
    "vitest": "2.1.9"
  }
}
